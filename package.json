{
  "name": "ThreeFlow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "answer"
  },
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "doctor": "node scripts/doctor-prod.mjs",
    "sync:decoders": "node scripts/sync-three-decoders.mjs",
    "compress:web": "node scripts/compress-web-assets.mjs",
    "build": "vue-tsc -b && vite build",
    "build:pro": "node scripts/doctor-prod.mjs && vue-tsc -b && vite build --mode production",
    "bake:hd-terrain": "node scripts/bake-hd-terrain.mjs",
    "bake:minimaps": "node scripts/bake-sector-minimaps.mjs",
    "generate:hd-terrain": "npx --yes tsx scripts/generate-hd-terrain.ts",
    "upload:hd-terrain": "node scripts/upload-hd-terrain.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings=0 --fix",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "prepare": "node -e \"if(!process.env.VERCEL){try{require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}}\"",
    "lint:lint-staged": "lint-staged",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@grudge-studio/animator": "file:vendor/@grudge-studio/animator",
    "@grudge-studio/asset-resolver": "file:vendor/@grudge-studio/asset-resolver",
    "@grudge-studio/assets": "file:vendor/@grudge-studio/assets",
    "@grudge-studio/core": "file:vendor/@grudge-studio/core",
    "@grudge-studio/engine": "file:vendor/@grudge-studio/engine",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@element-plus/icons-vue": "^2.3.1",
    "@vitejs/plugin-vue-jsx": "^3.0.1",
    "element-plus": "^2.9.4",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "pinia": "^2.3.1",
    "postprocessing": "^6.39.4",
    "sass": "^1.84.0",
    "@tweenjs/tween.js": "^18.5.0",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.14",
    "three-pathfinding": "^1.3.0",
    "three-viewport-gizmo": "^2.2.0",
    "vue": "^3.5.13",
    "vue-router": "^4.0.13",
    "yuka": "^0.7.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/js": "^9.20.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.1",
    "@types/three": "^0.185.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/babel-plugin-jsx": "^1.1.5",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.4.3",
    "postcss": "^8.5.1",
    "postcss-html": "^1.8.0",
    "prettier": "^3.5.0",
    "stylelint": "^16.14.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vite-plugin-wasm": "^3.6.0",
    "vue-tsc": "^2.2.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --ext .js,.jsx,.vue,.ts,.tsx --fix --quiet ./",
      "stylelint --fix \"packages/components/src/**/*.{css,less}\""
    ]
  }
}
