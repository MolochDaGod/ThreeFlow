{
  "installCommand": "npm install --legacy-peer-deps --ignore-scripts",
  "buildCommand": "npx vite build --mode production",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/preview", "destination": "/preview.html" },
    { "source": "/((?!assets|js|static|threeFile|image|icon).*)", "destination": "/index.html" }
  ]
}
